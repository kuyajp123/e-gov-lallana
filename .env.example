APP_NAME="Barangay Lallana E-Government"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Database (sqlite for local/CI, or postgresql via DATABASE_URL for staging/production)
DB_CONNECTION=sqlite
# DATABASE_URL=
# DB_SSLMODE=require

# State & Cache (Database backed)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=s3

# SMS Provider (textbee, semaphore, or fake)
SMS_DRIVER=fake
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# Cloudflare Turnstile Bot Protection
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email (Resend / SMTP)
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="no-reply@barangaylallana.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"

# Supabase Storage (S3-Compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
VITE_TURNSTILE_SITE_KEY=

# Initial Super Administrators (JSON array of admin objects)
# Example: SUPER_ADMINS='[{"name": "Admin Name", "email": "admin@example.com", "password": "secure-password"}]'
SUPER_ADMINS=
